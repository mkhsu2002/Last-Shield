{
  "private": true,
  "name": "last-shield",
  "version": "0.42.0",
  "type": "module",
  "scripts": {
    "dev": "devvit playtest",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test src/shared/game-logic.test.ts src/client/records.test.ts src/client/coaching.test.ts",
    "deploy": "npm run check && npm run build && devvit upload",
    "login": "devvit login",
    "build:standalone": "vite build --config vite.standalone.config.ts"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "6.0.3",
    "vite": "8.3.7"
  }
}
