{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "last-shield",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "height": "tall",
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a Last Shield game post",
        "description": "Post a playable Last Shield round",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-post"
      },
      {
        "label": "Update Last Shield share image",
        "description": "Refresh the social preview image for this game post",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/update-share-card"
      }
    ]
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "redis": true,
    "reddit": true,
    "http": {
      "enable": false
    },
    "media": true
  },
  "dev": {
    "subreddit": "last_shield_stage"
  }
}
